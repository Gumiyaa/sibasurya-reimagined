---
import MainLayout from '@/layouts/MainLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import InformationPanel from '@/components/ui/InformationPanel.astro';
import ContactForm from '@/components/forms/ContactForm.astro';
import Icon from '@/components/ui/Icon.astro';
import { company } from '@/data/company';
import { contact } from '@/data/contact';
import { branches } from '@/data/branches';
import { images } from '@/data/images';

const hq = branches.find((branch) => branch.status === 'HQ');
const hours = [
  { label: 'Senin – Jumat', value: '08.00 – 17.00 WIB' },
  { label: 'Sabtu', value: '08.00 – 13.00 WIB' },
  { label: 'Minggu & hari besar', value: 'Dispatch on-call' },
];
---

<MainLayout
  title="Kontak & Permintaan Penawaran — PT Siba Surya"
  description="Hubungi PT Siba Surya untuk permintaan penawaran angkutan berat, dedicated fleet, konsultasi rute, dan informasi perusahaan. Kantor pusat dispatch di Semarang, Jawa Tengah."
>
  <PageHero
    index="08"
    label="Contact & inquiries"
    code="Dispatch desk · Semarang"
    breadcrumb={[
      { label: 'Beranda', href: '/' },
      { label: 'Kontak' },
    ]}
    titleLines={['Bicara langsung', { text: 'dengan dispatch.', accent: true }]}
    lead="Sampaikan kebutuhan angkutan, rute, dan karakter muatan. Tim dispatch akan meninjau kelayakan operasional sebelum mengusulkan armada dan jadwal."
    image={images.controlRoom}
    imageAlt="Ruang kendali operasional dengan layar pemantauan"
    imageCaption="Command desk — fotografi stok sementara"
    meta={[
      { label: 'Telepon sentral', value: company.contact.phoneLabel },
      { label: 'Email dispatch', value: company.contact.email },
      { label: 'Kantor pusat', value: 'Semarang · Jawa Tengah' },
      { label: 'Respons', value: 'Jam operasional' },
    ]}
  />

  <section class="contact-channels section" aria-labelledby="contact-channels-title">
    <div class="shell">
      <div class="contact-channels__head">
        <div>
          <SectionLabel index="01" text="Kanal resmi" />
          <SectionHeading
            id="contact-channels-title"
            class="contact-channels__heading"
            lines={['Pilih kanal', { text: 'yang paling sesuai.', accent: true }]}
            size="h2"
          />
        </div>
        <p class="copy contact-channels__lead">{contact.responseNote}</p>
      </div>

      <div class="contact-channels__grid">
        {contact.channels.map((channel, index) => (
          <a class="channel-card" href={channel.href}>
            <span class="channel-card__index num">{String(index + 1).padStart(2, '0')}</span>
            <span class="channel-card__label">{channel.label}</span>
            <span class="channel-card__value">{channel.value}</span>
            <span class="channel-card__note">{channel.note}</span>
            <span class="channel-card__arrow" aria-hidden="true">
              <Icon name="arrow-up-right" size={14} />
            </span>
          </a>
        ))}
      </div>

      <div class="contact-channels__foot">
        <InformationPanel label="Whistleblowing GCG" index="WBS" tone="accent">
          <p>{company.whistleblowing.note}</p>
          <a class="link-arrow contact-channels__wbs" href={contact.whistleblowing.href} target="_blank" rel="noopener noreferrer">
            {contact.whistleblowing.value}
            <Icon name="arrow-up-right" size={14} />
          </a>
        </InformationPanel>

        <InformationPanel label="Catatan formulir" index="OPS">
          <p>
            Formulir di bawah memvalidasi data di browser dan belum terhubung ke
            backend produksi. Tidak ada data yang tersimpan saat halaman ini
            dijalankan tanpa API. Gunakan email atau telepon untuk pengiriman resmi.
          </p>
        </InformationPanel>
      </div>
    </div>
  </section>

  <section class="contact-form-section section section--ink-2" aria-labelledby="contact-form-title">
    <div class="shell contact-form-section__layout">
      <div class="contact-form-section__intro">
        <SectionLabel index="02" text="Formulir permintaan" />
        <SectionHeading
          id="contact-form-title"
          class="contact-form-section__heading"
          lines={['Rinci kebutuhan', { text: 'angkutan Anda.', accent: true }]}
          size="h2"
        />
        <p class="copy contact-form-section__copy">
          Semakin lengkap informasi asal, tujuan, tonase, dan dimensi kargo, semakin
          cepat tim dispatch dapat menilai kelayakan rute dan ketersediaan unit.
        </p>

        <ul class="contact-checklist">
          <li>
            <Icon name="check" size={13} />
            Asal dan tujuan pengiriman
          </li>
          <li>
            <Icon name="check" size={13} />
            Jenis serta estimasi volume komoditas
          </li>
          <li>
            <Icon name="check" size={13} />
            Jadwal, frekuensi, dan kebutuhan khusus
          </li>
        </ul>

        <InformationPanel label="Kerahasiaan" index="SEC" class="contact-form-section__panel">
          <p>
            Informasi komersial yang Anda kirimkan digunakan hanya untuk meninjau
            permintaan angkutan. Jangan menyertakan data pribadi sensitif pada
            kolom detail.
          </p>
        </InformationPanel>
      </div>

      <div class="contact-form-section__form">
        <ContactForm headingId="contact-form-title" />
      </div>
    </div>
  </section>

  <section class="office section" id="kantor" aria-labelledby="office-title">
    <div class="shell office__layout">
      <div class="office__main">
        <SectionLabel index="03" text="Kantor pusat dispatch" />
        <SectionHeading
          id="office-title"
          class="office__heading"
          lines={['Semarang,', { text: 'titik kendali armada.', accent: true }]}
          size="h2"
        />

        <p class="copy office__copy">
          Command desk dan central workshop beroperasi dari Semarang. Seluruh
          koordinasi ritase, pemantauan perjalanan, dan eskalasi insiden mengalir
          melalui kantor pusat ini.
        </p>

        <address class="office__address">
          <span class="micro">{company.hq.label}</span>
          {company.hq.lines.map((line) => <span>{line}</span>)}
          <span class="office__coords">Koordinat indikatif · {company.hq.coordinates}</span>
        </address>

        <div class="office__contacts">
          <a href={`tel:${company.contact.phone}`}>
            <Icon name="phone" size={15} />
            <span>
              <span class="micro">Telepon</span>
              {company.contact.phoneLabel}
            </span>
          </a>
          <a href={`mailto:${company.contact.email}`}>
            <Icon name="mail" size={15} />
            <span>
              <span class="micro">Email</span>
              {company.contact.email}
            </span>
          </a>
        </div>

        <div class="office__hours">
          <span class="micro">Jam operasional kantor</span>
          <dl>
            {hours.map((row) => (
              <div>
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <aside class="office__aside" aria-label="Informasi kunjungan">
        <div class="office-map" role="img" aria-label="Skema lokasi kantor pusat di Semarang, bukan peta berskala">
          <span class="office-map__grid" aria-hidden="true"></span>
          <span class="office-map__road office-map__road--h" aria-hidden="true"></span>
          <span class="office-map__road office-map__road--v" aria-hidden="true"></span>
          <span class="office-map__label office-map__label--city">Semarang</span>
          <span class="office-map__label office-map__label--port">Terboyo</span>
          <span class="office-map__pin" aria-hidden="true"></span>
          <span class="office-map__pin-label">PT Siba Surya · HQ</span>
        </div>

        <InformationPanel label="Sebelum berkunjung" index="VIS">
          <p>
            Kunjungan kantor dan workshop sebaiknya dijadwalkan lebih dahulu agar
            tim yang relevan tersedia. Untuk urusan armada, hubungi dispatch sebelum
            datang.
          </p>
          <a class="link-arrow office__panel-link" href={`mailto:${company.contact.email}`}>
            Jadwalkan kunjungan
            <Icon name="arrow-right" size={13} />
          </a>
        </InformationPanel>

        <InformationPanel label="Depot lain" index="NET">
          <p>
            Jaringan mencakup {branches.length} depot dan hub di Jawa dan Sumatra.
            Detail kontak cabang menyusul verifikasi resmi.
          </p>
          <a class="link-arrow office__panel-link" href="/network/">
            Lihat jaringan
            <Icon name="arrow-right" size={13} />
          </a>
        </InformationPanel>
      </aside>
    </div>
  </section>

  {hq && (
    <section class="contact-note section section--surface" aria-labelledby="contact-note-title">
      <div class="shell contact-note__inner">
        <div>
          <SectionLabel index="04" text="Status data" />
          <h2 class="display display--h3 contact-note__title" id="contact-note-title">
            Data kontak dan operasional menunggu verifikasi resmi.
          </h2>
        </div>
        <p class="contact-note__copy">
          Alamat kantor pusat, nomor telepon, dan email mengacu pada approved design
          reference. Alamat serta kontak depot selain Semarang belum ditampilkan
          sampai terkonfirmasi. Formulir belum mengirim data ke backend.
        </p>
      </div>
    </section>
  )}
</MainLayout>

<style>
  /* Channels ----------------------------------------------------------- */
  .contact-channels__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: end;
    padding-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  @media (min-width: 56rem) {
    .contact-channels__head {
      grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.6fr);
      gap: 2.5rem;
    }
  }

  .contact-channels__heading {
    margin-top: 1rem;
  }

  .contact-channels__lead {
    max-width: 38ch;
  }

  .contact-channels__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    border: 1px solid var(--line);
    background: var(--line);
  }

  @media (min-width: 48rem) {
    .contact-channels__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .channel-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 1.25rem 1.4rem;
    background: var(--ink);
    transition: background var(--dur);
  }

  .channel-card:hover {
    background: var(--ink-2);
  }

  .channel-card__index {
    font-size: var(--fs-micro);
    letter-spacing: 0.14em;
    color: var(--accent-ink);
  }

  .channel-card__label {
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .channel-card__value {
    margin-top: 0.15rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 600;
    line-height: 1.02;
    color: var(--paper);
    overflow-wrap: anywhere;
  }

  .channel-card__note {
    font-size: var(--fs-xs);
    line-height: 1.55;
    color: var(--muted);
  }

  .channel-card__arrow {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    color: var(--dim);
    transition:
      color var(--dur),
      transform var(--dur);
  }

  .channel-card:hover .channel-card__arrow {
    color: var(--accent-ink);
    transform: translate(2px, -2px);
  }

  .contact-channels__foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (min-width: 56rem) {
    .contact-channels__foot {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .contact-channels__wbs {
    margin-top: 0.8rem;
  }

  /* Form --------------------------------------------------------------- */
  .contact-form-section__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .contact-form-section__layout {
      grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.28fr);
    }
  }

  .contact-form-section__heading {
    margin-top: 1rem;
  }

  .contact-form-section__copy {
    margin-top: 1rem;
    max-width: 44ch;
  }

  .contact-checklist {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 1.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .contact-checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--muted);
  }

  .contact-checklist svg {
    flex: none;
    margin-top: 0.15rem;
    color: var(--accent-ink);
  }

  .contact-form-section__panel {
    margin-top: 1.25rem;
  }

  .contact-form-section__form {
    min-width: 0;
    padding: clamp(1.15rem, 2.4vw, 1.75rem);
    border: 1px solid var(--line);
    background: rgba(11, 14, 19, 0.45);
  }

  /* Office ------------------------------------------------------------- */
  .office__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .office__layout {
      grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    }
  }

  .office__heading {
    margin-top: 1rem;
  }

  .office__copy {
    margin-top: 1.1rem;
    max-width: 56ch;
  }

  .office__address {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 1.4rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    background: rgba(11, 14, 19, 0.35);
    font-style: normal;
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--paper-soft);
  }

  .office__address .micro {
    margin-bottom: 0.2rem;
    color: var(--dim);
  }

  .office__coords {
    margin-top: 0.3rem;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .office__contacts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 36rem) {
    .office__contacts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .office__contacts a {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    background: rgba(11, 14, 19, 0.3);
    color: var(--paper-soft);
    transition:
      border-color var(--dur),
      color var(--dur);
  }

  .office__contacts a:hover {
    border-color: var(--accent-line);
    color: var(--paper);
  }

  .office__contacts svg {
    flex: none;
    margin-top: 0.2rem;
    color: var(--accent-ink);
  }

  .office__contacts .micro {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--dim);
  }

  .office__contacts span span {
    font-size: var(--fs-sm);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .office__hours {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .office__hours dl {
    display: flex;
    flex-direction: column;
    margin-top: 0.65rem;
  }

  .office__hours dl > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.45rem;
    border-bottom: 1px solid var(--line);
  }

  .office__hours dl > div:last-child {
    border-bottom: 0;
  }

  .office__hours dt {
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .office__hours dd {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--paper-soft);
    text-align: right;
  }

  .office__aside {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .office-map {
    position: relative;
    min-height: 16rem;
    border: 1px solid var(--line-strong);
    background:
      radial-gradient(340px 200px at 62% 42%, rgba(226, 29, 46, 0.09), transparent 72%),
      rgba(8, 10, 14, 0.55);
    overflow: hidden;
  }

  .office-map__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(41, 46, 56, 0.45) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(41, 46, 56, 0.45) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: radial-gradient(circle at 55% 50%, black 30%, transparent 90%);
  }

  .office-map__road {
    position: absolute;
    background: rgba(242, 242, 242, 0.16);
  }

  .office-map__road--h {
    left: 0;
    right: 0;
    top: 58%;
    height: 1px;
  }

  .office-map__road--v {
    top: 0;
    bottom: 0;
    left: 46%;
    width: 1px;
  }

  .office-map__label {
    position: absolute;
    font-size: 0.56rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .office-map__label--city {
    left: 1rem;
    bottom: 0.9rem;
  }

  .office-map__label--port {
    right: 1rem;
    top: 0.9rem;
  }

  .office-map__pin {
    position: absolute;
    left: 46%;
    top: 58%;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border: 1px solid var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 5px rgba(226, 29, 46, 0.16);
  }

  .office-map__pin-label {
    position: absolute;
    left: calc(46% + 1rem);
    top: calc(58% - 0.4rem);
    padding: 0.2rem 0.4rem;
    border: 1px solid var(--accent-line);
    background: rgba(8, 10, 14, 0.82);
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
    white-space: nowrap;
  }

  .office__panel-link {
    margin-top: 0.8rem;
  }

  /* Data note ---------------------------------------------------------- */
  .contact-note__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  @media (min-width: 56rem) {
    .contact-note__inner {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr);
      gap: 2.5rem;
    }
  }

  .contact-note__title {
    margin-top: 1rem;
    max-width: 22ch;
  }

  .contact-note__copy {
    max-width: 56ch;
    font-size: var(--fs-sm);
    line-height: 1.7;
    color: var(--muted);
  }
</style>
