---
import { Image } from 'astro:assets';
import type { ServiceItem } from '@/types';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  service: ServiceItem;
  reverse?: boolean;
}

const { service, reverse = false } = Astro.props;
---

<article class:list={['service-panel', { 'service-panel--reverse': reverse }]} data-reveal>
  <div class="service-panel__media">
    <Image
      src={service.image}
      alt={service.alt}
      widths={[480, 720, 960]}
      sizes="(min-width: 64rem) 38vw, 100vw"
      format="webp"
      quality={76}
      loading="lazy"
      decoding="async"
      class="service-panel__image"
    />
    <span class="service-panel__num" aria-hidden="true">{service.index}</span>
    <span class="service-panel__scrim" aria-hidden="true"></span>
    <p class="service-panel__media-label">Operational architecture · {service.index}</p>
  </div>

  <div class="service-panel__body">
    <SectionLabel index={service.index} text={service.kicker} />

    <h3 class="display display--h3 service-panel__title">{service.title}</h3>
    <p class="service-panel__desc">{service.description}</p>

    <ul class="service-panel__list">
      {service.bullets.map((bullet) => (
        <li>
          <Icon name="check" size={14} />
          <span>{bullet}</span>
        </li>
      ))}
    </ul>

    <dl class="service-panel__metrics">
      {service.metrics.map((metric) => (
        <div class="service-panel__metric">
          <dt>{metric.label}</dt>
          <dd>{metric.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</article>

<style>
  .service-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    border-top: 1px solid var(--line);
    padding-block: clamp(2rem, 4vw, 3.25rem);
  }

  @media (min-width: 64rem) {
    .service-panel {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
      gap: clamp(2rem, 4vw, 4.25rem);
    }

    .service-panel--reverse {
      grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
    }

    .service-panel--reverse .service-panel__media {
      order: 2;
    }
  }

  .service-panel__media {
    position: relative;
    min-height: clamp(16rem, 30vw, 25rem);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .service-panel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.4) contrast(1.04) brightness(0.82);
  }

  .service-panel__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 14, 19, 0.15) 0%, rgba(11, 14, 19, 0.75) 100%);
  }

  .service-panel__num {
    position: absolute;
    top: 0.6rem;
    left: 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 6vw, 5.5rem);
    font-weight: 600;
    line-height: 1;
    color: rgba(242, 242, 242, 0.18);
  }

  .service-panel__media-label {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.85rem;
    padding-top: 0.6rem;
    border-top: 1px solid rgba(242, 242, 242, 0.22);
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--paper-soft);
  }

  .service-panel__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 1.25rem;
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .service-panel__body {
      padding-top: 0;
    }
  }

  .service-panel__title {
    margin-top: 1rem;
    max-width: 20ch;
  }

  .service-panel__desc {
    margin-top: 1rem;
    font-size: var(--fs-body);
    line-height: 1.75;
    color: var(--muted);
    max-width: 58ch;
  }

  .service-panel__list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 1.4rem;
  }

  .service-panel__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: var(--fs-xs);
    line-height: 1.55;
    color: var(--paper-soft);
  }

  .service-panel__list svg {
    flex: none;
    margin-top: 0.18rem;
    color: var(--accent-ink);
  }

  .service-panel__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .service-panel__metric {
    padding: 0.8rem 0.75rem 0.8rem 0;
    border-right: 1px solid var(--line);
  }

  .service-panel__metric:last-child {
    border-right: 0;
    padding-right: 0;
  }

  .service-panel__metric dt {
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .service-panel__metric dd {
    margin: 0.3rem 0 0;
    font-size: var(--fs-xs);
    color: var(--paper);
    line-height: 1.4;
  }

  @media (max-width: 30rem) {
    .service-panel__metrics {
      grid-template-columns: minmax(0, 1fr);
    }

    .service-panel__metric {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding-block: 0.65rem;
    }

    .service-panel__metric:last-child {
      border-bottom: 0;
    }
  }
</style>
