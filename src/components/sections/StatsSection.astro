---
import { statistics } from '@/data/statistics';
import { company } from '@/data/company';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import StatisticBlock from '@/components/ui/StatisticBlock.astro';
---

<section class="stats section section--ink-2 section--tight" aria-labelledby="stats-title">
  <div class="shell">
    <div class="stats__head">
      <div class="stats__intro">
        <SectionLabel index="02" text="Operational scale" />
        <h2 class="stats__title" id="stats-title">Skala operasional, diukur setiap hari.</h2>
      </div>
      <p class="micro stats__note">
        Data operasional mengacu pada approved design reference.<br />
        Verifikasi resmi diperlukan sebelum publikasi.
      </p>
    </div>

    <div class="stats__grid">
      {statistics.map((stat, index) => (
        <StatisticBlock
          index={stat.index}
          value={stat.value}
          unit={stat.unit}
          label={stat.label}
          detail={stat.detail}
          accent={index === 1}
        />
      ))}
    </div>

    <div class="stats__foot">
      <span>{company.coverage.network}</span>
      <span class="stats__foot-right">ISO 39001 · ISO 9001 · Est. 1951</span>
    </div>
  </div>
</section>

<style>
  .stats {
    border-top: 0;
  }

  .stats__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  .stats__intro {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .stats__title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.8vw, 2.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--paper);
  }

  .stats__note {
    max-width: 34ch;
    line-height: 1.7;
    text-align: right;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 36rem) {
    .stats__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 56rem) {
    .stats__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stats__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 0.75rem;
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .stats__foot-right {
    color: var(--muted);
  }

  @media (max-width: 36rem) {
    .stats__note {
      text-align: left;
    }
  }
</style>
