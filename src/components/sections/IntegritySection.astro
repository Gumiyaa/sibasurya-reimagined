---
import { company } from '@/data/company';
import { integrityStatement } from '@/data/values';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Icon from '@/components/ui/Icon.astro';

const whistleLink = `https://wa.me/${company.whistleblowing.phone.replace('+', '')}`;
---

<section class="integrity section" id="integritas" aria-labelledby="integrity-title">
  <div class="shell">
    <div class="integrity__panel corner-marks">
      <div class="integrity__main">
        <SectionLabel index="08" text={integrityStatement.eyebrow} />

        <h2 class="display display--h2 integrity__title" id="integrity-title">
          Menolak segala bentuk <span class="accent">suap, pungli,</span> dan gratifikasi.
        </h2>

        <p class="integrity__body">{integrityStatement.body}</p>

        <div class="integrity__actions">
          <a class="btn btn--primary" href={whistleLink} target="_blank" rel="noopener noreferrer">
            Laporkan via whistleblowing
            <Icon name="arrow-up-right" size={16} />
          </a>
          <a class="btn btn--ghost" href="/values/#integritas">
            Baca komitmen GCG
            <Icon name="shield" size={16} />
          </a>
        </div>
      </div>

      <aside class="integrity__aside" aria-label="Kanal whistleblowing">
        <span class="integrity__icon" aria-hidden="true">
          <Icon name="shield" size={30} />
        </span>

        <p class="micro">{company.whistleblowing.label}</p>
        <a class="integrity__phone num" href={`tel:${company.whistleblowing.phone}`}>
          {company.whistleblowing.phoneLabel}
        </a>

        <p class="integrity__note">{integrityStatement.note}</p>

        <div class="integrity__rule" aria-hidden="true"></div>

        <blockquote class="integrity__quote">
          <p>“Tanpa disiplin dan kerja keras tidak akan ada perbaikan.”</p>
          <footer>
            <span>Daniel Setiawan</span>
            <span>Presiden Komisaris</span>
          </footer>
        </blockquote>
      </aside>
    </div>

    <p class="integrity__foot">
      <Icon name="file" size={13} />
      <span>{company.dataStatus}</span>
    </p>
  </div>
</section>

<style>
  .integrity {
    border-top: 0;
    background:
      linear-gradient(180deg, rgba(226, 29, 46, 0.035), transparent 40%),
      var(--ink);
  }

  .integrity__panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.75rem, 3.5vw, 3rem);
    padding: clamp(1.5rem, 3.5vw, 3rem);
    border: 1px solid var(--line-strong);
    border-left: 3px solid var(--accent);
    background:
      linear-gradient(115deg, rgba(226, 29, 46, 0.06), transparent 38%),
      rgba(17, 21, 29, 0.72);
  }

  @media (min-width: 64rem) {
    .integrity__panel {
      grid-template-columns: minmax(0, 1.45fr) minmax(17rem, 0.55fr);
      align-items: start;
    }
  }

  .integrity__main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .integrity__title {
    margin-top: 1.15rem;
    max-width: 19ch;
  }

  .integrity__body {
    margin-top: 1.2rem;
    max-width: 62ch;
    font-size: var(--fs-body);
    line-height: 1.75;
    color: var(--muted);
  }

  .integrity__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.6rem;
  }

  .integrity__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.1rem, 2vw, 1.5rem);
    border: 1px solid var(--accent-line);
    background: rgba(8, 10, 14, 0.5);
  }

  .integrity__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.9rem;
    border: 1px solid var(--accent-line);
    color: var(--accent-ink);
  }

  .integrity__phone {
    margin-top: 0.3rem;
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.03em;
    color: var(--paper);
    transition: color var(--dur);
  }

  .integrity__phone:hover {
    color: var(--accent-ink);
  }

  .integrity__note {
    margin-top: 0.65rem;
    font-size: var(--fs-xs);
    line-height: 1.6;
    color: var(--dim);
  }

  .integrity__rule {
    width: 100%;
    height: 1px;
    margin-block: 1rem;
    background: var(--line);
  }

  .integrity__quote p {
    font-size: var(--fs-sm);
    font-style: italic;
    line-height: 1.65;
    color: var(--paper-soft);
  }

  .integrity__quote footer {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.65rem;
    font-size: 0.56rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .integrity__quote footer span:first-child {
    color: var(--paper);
  }

  .integrity__foot {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 0.9rem;
    font-size: 0.62rem;
    line-height: 1.6;
    color: var(--dim);
  }

  .integrity__foot svg {
    flex: none;
    margin-top: 0.1rem;
    color: var(--accent-ink);
  }

  @media (max-width: 35.99rem) {
    .integrity__actions .btn {
      width: 100%;
    }
  }
</style>
