---
import type { NavigationItem } from '@/types';
import { isNavigationActive } from '@/lib/navigation';
import { company } from '@/data/company';
import { utilityNavigation } from '@/data/navigation';
import Logo from '@/components/ui/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  items: NavigationItem[];
  pathname: string;
}

const { items, pathname } = Astro.props;
const isEnglish = pathname.startsWith('/en');
---

<div id="mobile-navigation" class="mobile-nav" data-mobile-nav-panel inert>
  <button class="mobile-nav__backdrop" type="button" data-nav-close tabindex="-1" aria-label="Tutup menu"></button>

  <div class="mobile-nav__panel" role="dialog" aria-modal="true" aria-label="Menu navigasi">
    <div class="mobile-nav__top">
      <Logo compact />
      <button class="mobile-nav__close" type="button" data-nav-close aria-label="Tutup menu navigasi">
        <Icon name="close" size={22} />
      </button>
    </div>

    <nav class="mobile-nav__main" aria-label="Navigasi utama seluler">
      <ul>
        {items.map((item) => {
          const active = isNavigationActive(pathname, item.href);
          return (
            <li>
              <a
                class:list={['mobile-nav__link', { 'is-active': active }]}
                href={item.href}
                aria-current={active ? 'page' : undefined}
              >
                <span class="mobile-nav__index num">{item.index}</span>
                <span class="mobile-nav__text">
                  <span class="mobile-nav__label">{item.label}</span>
                  {item.description && <span class="mobile-nav__desc">{item.description}</span>}
                </span>
                <Icon name="arrow-up-right" size={16} />
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="mobile-nav__secondary">
      <div class="mobile-nav__utility">
        {utilityNavigation.map((item) => (
          <a class="mobile-nav__util-link" href={item.href}>
            {item.label}
            <Icon name="chevron-right" size={14} />
          </a>
        ))}
      </div>

      <a class="mobile-nav__contact" href={`tel:${company.contact.phone}`}>
        <span class="micro">Central dispatch</span>
        <strong>{company.contact.phoneLabel}</strong>
      </a>

      <div class="mobile-nav__meta">
        <LanguageSwitcher current={isEnglish ? 'en' : 'id'} idHref={isEnglish ? '/' : pathname} compact />
        <span>{company.establishedLabel}</span>
      </div>
    </div>
  </div>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav-panel]');

  if (toggle && panel) {
    const closeTargets = panel.querySelectorAll<HTMLElement>('[data-nav-close]');
    const focusables = () =>
      Array.from(
        panel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((element) => element.offsetParent !== null);

    let lastFocused: HTMLElement | null = null;

    const open = () => {
      lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      panel.inert = false;
      panel.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.classList.add('is-locked');
      const first = panel.querySelector<HTMLElement>('[data-nav-close]');
      window.setTimeout(() => first?.focus(), 40);
    };

    const close = (restoreFocus = true) => {
      panel.classList.remove('is-open');
      panel.inert = true;
      toggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('is-locked');
      if (restoreFocus) {
        (lastFocused ?? toggle).focus();
      }
    };

    toggle.addEventListener('click', () => {
      if (panel.classList.contains('is-open')) {
        close();
      } else {
        open();
      }
    });

    closeTargets.forEach((target) => target.addEventListener('click', () => close()));

    panel.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
      link.addEventListener('click', () => close(false));
    });

    document.addEventListener('keydown', (event) => {
      if (!panel.classList.contains('is-open')) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        close();
        return;
      }

      if (event.key !== 'Tab') return;

      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];
      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    window.matchMedia('(min-width: 64rem)').addEventListener('change', (event) => {
      if (event.matches && panel.classList.contains('is-open')) close(false);
    });
  }
</script>

<style>
  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: flex;
    justify-content: flex-end;
    visibility: hidden;
    transition: visibility 0s linear var(--dur);
  }

  .mobile-nav.is-open {
    visibility: visible;
    transition-delay: 0s;
  }

  .mobile-nav__backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(4, 6, 9, 0.72);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }

  .mobile-nav.is-open .mobile-nav__backdrop {
    opacity: 1;
  }

  .mobile-nav__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(28rem, 92vw);
    height: 100%;
    max-height: 100dvh;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--ink-2);
    border-left: 1px solid var(--line-strong);
    transform: translateX(100%);
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .mobile-nav.is-open .mobile-nav__panel {
    transform: none;
  }

  .mobile-nav__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem var(--gutter);
    border-bottom: 1px solid var(--line);
  }

  .mobile-nav__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--paper);
    transition:
      border-color var(--dur),
      color var(--dur);
  }

  .mobile-nav__close:hover {
    border-color: var(--accent-ink);
    color: var(--accent-ink);
  }

  .mobile-nav__main {
    padding: 0.5rem var(--gutter) 0;
  }

  .mobile-nav__link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    transition: color var(--dur);
  }

  .mobile-nav__link.is-active {
    color: var(--paper);
  }

  .mobile-nav__link:hover {
    color: var(--paper);
  }

  .mobile-nav__index {
    flex: none;
    width: 1.4rem;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--dim);
  }

  .mobile-nav__link.is-active .mobile-nav__index {
    color: var(--accent-ink);
  }

  .mobile-nav__text {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    flex: 1;
    min-width: 0;
  }

  .mobile-nav__label {
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .mobile-nav__link.is-active .mobile-nav__label {
    color: var(--accent-ink);
  }

  .mobile-nav__desc {
    font-size: 0.65rem;
    letter-spacing: 0.02em;
    color: var(--dim);
    line-height: 1.35;
  }

  .mobile-nav__link svg {
    flex: none;
    color: var(--dim);
  }

  .mobile-nav__secondary {
    margin-top: auto;
    padding: 1.4rem var(--gutter) calc(1.4rem + env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-nav__utility {
    display: flex;
    gap: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .mobile-nav__util-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .mobile-nav__util-link:hover {
    color: var(--paper);
  }

  .mobile-nav__contact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .mobile-nav__contact strong {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .mobile-nav__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--fs-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }

  @media (min-width: 64rem) {
    .mobile-nav {
      display: none;
    }
  }
</style>
