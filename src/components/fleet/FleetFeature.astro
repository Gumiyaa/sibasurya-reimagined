---
import { Image } from 'astro:assets';
import type { FleetCategory } from '@/types';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  category: FleetCategory;
  index?: string;
}

const { category, index = '03' } = Astro.props;
---

<article class="fleet-feature" data-reveal>
  <div class="fleet-feature__media corner-marks">
    <Image
      src={category.image}
      alt={category.alt}
      widths={[560, 840, 1200]}
      sizes="(min-width: 64rem) 56vw, 100vw"
      format="webp"
      quality={78}
      loading="lazy"
      decoding="async"
      class="fleet-feature__image"
    />
    <span class="fleet-feature__overlay" aria-hidden="true"></span>
    <span class="fleet-feature__code">{category.code}</span>
    <p class="fleet-feature__caption">
      <span>{category.shortName} class</span>
      <span>{category.axle}</span>
    </p>
  </div>

  <div class="fleet-feature__body">
    <div class="fleet-feature__topline">
      <SectionLabel index={index} text="Fleet capability catalog" />
      <span class="fleet-feature__capacity num">{category.capacity}</span>
    </div>

    <h3 class="display display--h2 fleet-feature__title">{category.name}</h3>
    <p class="fleet-feature__desc">{category.description}</p>

    <dl class="fleet-feature__specs">
      {category.specs.slice(0, 4).map((spec) => (
        <div class="fleet-feature__spec">
          <dt>{spec.label}</dt>
          <dd>{spec.value}</dd>
        </div>
      ))}
    </dl>

    <div class="fleet-feature__footer">
      <ul class="fleet-feature__tags" aria-label="Komoditas utama">
        {category.commodities.slice(0, 3).map((commodity) => (
          <li>{commodity}</li>
        ))}
      </ul>

      <a class="link-arrow fleet-feature__link" href={`/fleet/${category.slug}/`}>
        Spesifikasi lengkap
        <Icon name="arrow-right" size={15} />
      </a>
    </div>
  </div>
</article>

<style>
  .fleet-feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.75rem, 3.2vw, 3rem);
    align-items: stretch;
  }

  @media (min-width: 64rem) {
    .fleet-feature {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    }
  }

  .fleet-feature__media {
    position: relative;
    min-height: clamp(20rem, 44vw, 37rem);
    border: 1px solid var(--line);
    overflow: hidden;
    background: var(--surface);
  }

  .fleet-feature__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.18) contrast(1.05) brightness(0.9);
    transition: transform 900ms var(--ease-out);
  }

  .fleet-feature:hover .fleet-feature__image {
    transform: scale(1.025);
  }

  .fleet-feature__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(11, 14, 19, 0.25) 0%, transparent 38%, rgba(8, 10, 14, 0.85) 100%),
      linear-gradient(90deg, rgba(11, 14, 19, 0.3), transparent 60%);
    pointer-events: none;
  }

  .fleet-feature__code {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid rgba(242, 242, 242, 0.22);
    background: rgba(11, 14, 19, 0.55);
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--paper-soft);
  }

  .fleet-feature__caption {
    position: absolute;
    left: 1.15rem;
    right: 1.15rem;
    bottom: 1rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.7rem;
    border-top: 1px solid rgba(242, 242, 242, 0.22);
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper-soft);
  }

  .fleet-feature__caption span:last-child {
    text-align: right;
    color: rgba(242, 242, 242, 0.55);
  }

  .fleet-feature__body {
    display: flex;
    flex-direction: column;
    padding-top: 0.35rem;
    min-width: 0;
  }

  .fleet-feature__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .fleet-feature__capacity {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent-ink);
    white-space: nowrap;
  }

  .fleet-feature__title {
    margin-top: 1.1rem;
    max-width: 12ch;
  }

  .fleet-feature__desc {
    margin-top: 1rem;
    font-size: var(--fs-body);
    line-height: 1.75;
    color: var(--muted);
    max-width: 48ch;
  }

  .fleet-feature__specs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .fleet-feature__spec {
    display: grid;
    grid-template-columns: minmax(7rem, 0.5fr) minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-xs);
  }

  .fleet-feature__spec dt {
    color: var(--dim);
    letter-spacing: 0.04em;
  }

  .fleet-feature__spec dd {
    margin: 0;
    color: var(--paper-soft);
    text-align: right;
  }

  .fleet-feature__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.4rem;
  }

  .fleet-feature__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .fleet-feature__tags li {
    padding: 0.28rem 0.45rem;
    border: 1px solid var(--line);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .fleet-feature__link {
    flex: none;
  }
</style>
