---
interface Props {
  index?: string;
  text: string;
  href?: string;
  class?: string;
  plain?: boolean;
}

const { index, text, href, class: className, plain = false } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  class:list={['section-label', { 'section-label--plain': plain }, className]}
  href={href}
  aria-hidden={href ? undefined : 'false'}
>
  {index && <span class="section-label__index">{index}</span>}
  <span class="section-label__rule" aria-hidden="true"></span>
  <span class="section-label__text">{text}</span>
</Tag>

<style>
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--muted);
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: 0.18em;
    line-height: 1.3;
    text-transform: uppercase;
    transition: color var(--dur);
  }

  a.section-label:hover {
    color: var(--paper);
  }

  .section-label__index {
    color: var(--accent-ink);
    font-variant-numeric: tabular-nums;
  }

  .section-label__rule {
    width: 1.4rem;
    height: 1px;
    background: var(--accent);
    flex: none;
  }

  .section-label--plain .section-label__rule {
    display: none;
  }
</style>
