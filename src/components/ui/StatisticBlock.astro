---
interface Props {
  index?: string;
  value: string;
  unit: string;
  label: string;
  detail?: string;
  accent?: boolean;
  class?: string;
}

const { index, value, unit, label, detail, accent = false, class: className } = Astro.props;
---

<article class:list={['stat', { 'stat--accent': accent }, className]}>
  <div class="stat__head">
    {index && <span class="stat__index num">{index}</span>}
    <span class="stat__tick" aria-hidden="true"></span>
  </div>
  <p class="stat__value num">
    {value}<span class="stat__unit">{unit}</span>
  </p>
  <h3 class="stat__label">{label}</h3>
  {detail && <p class="stat__detail">{detail}</p>}
</article>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: clamp(1.25rem, 2.4vw, 2rem) clamp(1rem, 2vw, 1.75rem);
    min-height: 100%;
    border-right: 1px solid var(--line);
  }

  .stat:last-child {
    border-right: 0;
  }

  .stat__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .stat__index {
    font-size: var(--fs-micro);
    letter-spacing: 0.16em;
    color: var(--dim);
  }

  .stat__tick {
    width: 5px;
    height: 5px;
    background: var(--line-strong);
  }

  .stat--accent .stat__tick {
    background: var(--accent);
  }

  .stat__value {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-size: clamp(2.9rem, 4.4vw, 4.6rem);
    font-weight: 600;
    line-height: 0.82;
    letter-spacing: -0.01em;
    color: var(--paper);
  }

  .stat--accent .stat__value {
    color: var(--accent-ink);
  }

  .stat__unit {
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .stat__label {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--paper-soft);
    letter-spacing: 0.01em;
  }

  .stat__detail {
    font-size: var(--fs-xs);
    line-height: 1.6;
    color: var(--dim);
    max-width: 26ch;
  }

  @media (max-width: 56rem) {
    .stat {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .stat:nth-child(odd) {
      border-right: 1px solid var(--line);
    }

    .stat:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
  }

  @media (max-width: 36rem) {
    .stat,
    .stat:nth-child(odd) {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding-inline: 0;
    }

    .stat:last-child {
      border-bottom: 0;
    }
  }
</style>
