---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';

interface TitleLine {
  text: string;
  accent?: boolean;
}

interface MetaItem {
  label: string;
  value: string;
}

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  index: string;
  label: string;
  titleLines: Array<string | TitleLine>;
  lead?: string;
  code?: string;
  breadcrumb?: Crumb[];
  meta?: MetaItem[];
  image?: ImageMetadata;
  imageAlt?: string;
  imageCaption?: string;
  hasAside?: boolean;
}

const {
  index,
  label,
  titleLines,
  lead,
  code,
  breadcrumb,
  meta = [],
  image,
  imageAlt = '',
  imageCaption,
  hasAside = false,
} = Astro.props;

const lines = titleLines.map((line) => (typeof line === 'string' ? { text: line, accent: false } : line));
const split = Boolean(image) || hasAside;
---

<header class="page-hero">
  <div class="page-hero__grid-bg" aria-hidden="true"></div>

  <div class="shell">
    {breadcrumb && breadcrumb.length > 0 && <Breadcrumb items={breadcrumb} />}

    <div class="page-hero__top">
      <SectionLabel index={index} text={label} />
      {code && <span class="page-hero__code">{code}</span>}
    </div>

    <div class:list={['page-hero__body', { 'page-hero__body--split': split }]}>
      <div class="page-hero__main">
        <h1 class="display display--h1 page-hero__title">
          {lines.map((line) => (
            <span class:list={['page-hero__line', { accent: line.accent }]}>{line.text}</span>
          ))}
        </h1>

        {lead && <p class="lead page-hero__lead">{lead}</p>}

        <div class="page-hero__actions">
          <slot name="actions" />
        </div>
      </div>

      {split && (
        <div class="page-hero__aside">
          {image ? (
            <figure class="page-hero__figure">
              <div class="page-hero__media">
                <Image
                  src={image}
                  alt={imageAlt}
                  widths={[480, 720, 980]}
                  sizes="(min-width: 64rem) 38vw, 100vw"
                  format="webp"
                  quality={78}
                  loading="eager"
                  decoding="async"
                  class="page-hero__image"
                />
                <span class="page-hero__scrim" aria-hidden="true"></span>
                {imageCaption && (
                  <figcaption class="page-hero__caption">{imageCaption}</figcaption>
                )}
              </div>
            </figure>
          ) : (
            <slot name="aside" />
          )}
        </div>
      )}
    </div>

    {meta.length > 0 && (
      <dl class="page-hero__meta">
        {meta.map((item) => (
          <div class="page-hero__meta-item">
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(900px 380px at 88% 0%, rgba(226, 29, 46, 0.08), transparent 70%),
      var(--ink);
  }

  .page-hero__grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(41, 46, 56, 0.26) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(41, 46, 56, 0.26) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.7), transparent 92%);
    pointer-events: none;
  }

  .page-hero .shell {
    position: relative;
  }

  .page-hero__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: clamp(1.25rem, 3vw, 2.25rem);
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .page-hero__code {
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .page-hero__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: end;
    padding-top: clamp(1.5rem, 3.5vw, 2.75rem);
  }

  @media (min-width: 64rem) {
    .page-hero__body--split {
      grid-template-columns: minmax(0, 1.12fr) minmax(19rem, 0.88fr);
    }
  }

  .page-hero__main {
    min-width: 0;
  }

  .page-hero__title {
    display: flex;
    flex-direction: column;
    max-width: 20ch;
    font-size: clamp(3rem, 6.4vw, 6.4rem);
    font-weight: 600;
    line-height: 0.84;
    letter-spacing: -0.014em;
    text-transform: uppercase;
  }

  .page-hero__line.accent {
    color: var(--accent-ink);
  }

  .page-hero__lead {
    margin-top: 1.4rem;
    max-width: 52ch;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  .page-hero__actions:empty {
    display: none;
  }

  .page-hero__figure {
    margin: 0;
  }

  .page-hero__media {
    position: relative;
    aspect-ratio: 4 / 3.1;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: var(--surface);
  }

  .page-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.35) contrast(1.05) brightness(0.83);
  }

  .page-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(8, 10, 14, 0.82) 100%);
  }

  .page-hero__caption {
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.75rem;
    padding-top: 0.55rem;
    border-top: 1px solid rgba(242, 242, 242, 0.22);
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper-soft);
  }

  .page-hero__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 48rem) {
    .page-hero__meta {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .page-hero__meta-item {
    padding: 0.85rem 1rem 0.85rem 0;
    border-right: 1px solid var(--line);
  }

  .page-hero__meta-item:last-child {
    border-right: 0;
  }

  .page-hero__meta-item dt {
    font-size: 0.56rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .page-hero__meta-item dd {
    margin: 0.35rem 0 0;
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--paper-soft);
  }

  @media (max-width: 36rem) {
    .page-hero__meta-item {
      padding-left: 0;
    }

    .page-hero__meta-item:nth-child(2n) {
      padding-left: 0.8rem;
      border-right: 0;
    }

    .page-hero__meta-item:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
  }
</style>
