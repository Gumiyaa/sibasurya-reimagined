---
import '@/styles/global.css';
import MainHeader from '@/components/navigation/MainHeader.astro';
import MainFooter from '@/components/layout/MainFooter.astro';
import BackToTop from '@/components/ui/BackToTop.astro';
import SEO from '@/components/seo/SEO.astro';
import displayFont from '@/assets/fonts/barlow-condensed-600.woff2?url';
import bodyFont from '@/assets/fonts/inter-var.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: string;
  lang?: 'id' | 'en';
  bodyClass?: string;
}

const {
  title,
  description,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  jsonLd,
  publishedTime,
  lang = 'id',
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0e13" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <link rel="icon" href="/favicon.png" sizes="64x64" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />

    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
      jsonLd={jsonLd}
      publishedTime={publishedTime}
    />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">Langsung ke konten</a>
    <MainHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <MainFooter />
    <BackToTop />

    <script>
      const revealNodes = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (reduceMotion.matches || !('IntersectionObserver' in window)) {
        revealNodes.forEach((node) => node.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.06 },
        );

        revealNodes.forEach((node) => observer.observe(node));

        // Safety net: never leave primary content hidden if the observer is
        // starved by an unusual layout or print context.
        window.setTimeout(() => {
          revealNodes.forEach((node) => {
            const rect = node.getBoundingClientRect();
            if (rect.top < window.innerHeight && rect.bottom > 0) {
              node.classList.add('is-visible');
            }
          });
        }, 1200);
      }
    </script>
  </body>
</html>
